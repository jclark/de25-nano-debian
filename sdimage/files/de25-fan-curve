#!/bin/sh
# Set the fan curve of the DE25-Nano's fan controller (AMC6821). Run by udev when the
# controller's hwmon device appears (60-de25-fan.rules), with the device's sysfs path as its
# argument. The settings are in /etc/default/de25-fan.
#
# The device tree must give the PWM polarity as inverted, as the overlay for the FPGA design
# does: then a higher PWM value is a faster fan.
set -eu
FAN_MIN_PWM=90
FAN_MIN_TEMP=64
FAN_FULL_TEMP=76
[ ! -r /etc/default/de25-fan ] || . /etc/default/de25-fan
h=${SYSFS:-/sys}$1
echo "$FAN_MIN_PWM"                > "$h/pwm1_auto_point2_pwm"
echo "$((FAN_MIN_TEMP * 1000))"    > "$h/temp2_auto_point2_temp"
echo "$((FAN_FULL_TEMP * 1000))"   > "$h/temp2_auto_point3_temp"
echo 2                             > "$h/pwm1_enable"    # automatic, following temp2 (the FPGA)

#!/bin/sh
# Build a Debian SD card image for the Terasic DE25-Nano.
#
# Usage: build-image INPUT_DIR OUTPUT_DIR
#
# INPUT_DIR holds:
#   linux-image-<release>_<version>_arm64.deb
#                    the kernel as a Debian package (kernel, modules, device trees), from the
#                    kernel's own "make bindeb-pkg"; the board's device tree in it must be
#                    built with symbols
#   de25-nano-fpga-tools_<version>_all.deb
#                    de25-fpga, and the fan and HDMI scripts (Task P)
#   de25-nano-boot-<name>_<version>_arm64.deb     optional, both or neither (Task P): the
#   de25-nano-core-<name>_<version>_arm64.deb       boot package (the HPS image for the flash,
#                      u-boot.itb, boot.scr) and one or more core packages. They are installed
#                      and not put into effect: that is "de25-fpga
#                      select", on the board.
#   u-boot.itb       without a boot package: U-Boot and TF-A from Task B; it has to match the
#   boot.cmd           SPL in the board's QSPI flash; and the source of the boot script
#   config           optional, the kernel configuration
#   authorized_keys  optional, ssh keys for the user
#
# Without a boot package and a core the image gives console and network only, on any board.
# The commands and the files for the fan and HDMI are installed all the same and stay idle.
# To add them later, on the card: install the two packages (sudo apt install ./*.deb).
#
# Settings, as environment variables (defaults in mkimage-inner.sh):
#   SUITE (trixie)  HOSTNAME_ (de25-nano)  USER_ (debian)
#   MAC (none: made up at the first boot and kept)  IMAGE_MB (1024)  IMAGE_NAME (de25-nano.img)
#
# The user's password is the user name. With authorized_keys present, ssh accepts keys only;
# without, the password has to be changed at first login. At the first boot the card also
# reads optional hostname and authorized_keys files from its FAT partition, and partition 2
# grows to fill the card.
#
# Needs Docker, and on a host that is not arm64, qemu-user binfmt for aarch64.
set -eu
[ $# -eq 2 ] || { sed -n '2,38p' "$0"; exit 2; }
here=$(dirname "$(readlink -f "$0")")
in=$(readlink -f "$1"); out=$(readlink -f "$2"); mkdir -p "$out"
docker build -q -t de25-nano-sdimage "$here" >/dev/null
# --privileged: mmdebstrap mounts /proc, /sys and /dev inside the new root filesystem.
exec docker run --rm --privileged \
  -e SUITE -e HOSTNAME_ -e USER_ -e MAC -e IMAGE_MB -e IMAGE_NAME -e FAT_MB -e DISK_ID \
  -e OWNER="$(id -u):$(id -g)" \
  -v "$in":/in:ro -v "$out":/out -v "$here":/sd:ro \
  -v /work \
  de25-nano-sdimage sh /sd/mkimage-inner.sh

+#if IS_ENABLED(CONFIG_OF_BOARD_SETUP) && IS_ENABLED(CONFIG_CADENCE_QSPI)
+#include <fdt_support.h>
+#include <spi_flash.h>
+
+/*
+ * Tell Linux about the QSPI flash, as the linux_qspi_enable script does: if the flash
+ * answers here, enable the controller in Linux's device tree and give its reference
+ * clock the rate the SDM reported when it handed the flash over.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	u32 hz = cm_get_qspi_controller_clk_hz();
+	struct udevice *flash;
+	int node;
+
+	if (!hz || spi_flash_probe_bus_cs(0, 0, &flash))
+		return 0;
+
+	node = fdt_path_offset(blob, "/clocks/qspi-clk");
+	if (node < 0)
+		return 0;
+	if (fdt_setprop_u32(blob, node, "clock-frequency", hz))
+		return 0;
+
+	node = fdt_node_offset_by_compatible(blob, -1, "cdns,qspi-nor");
+	if (node >= 0)
+		fdt_status_okay(blob, node);
+
+	return 0;
+}

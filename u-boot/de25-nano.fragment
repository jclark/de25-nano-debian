# Added to Terasic's socfpga_agilex5_de25_nano_defconfig (u-boot-socfpga, branch
# de25-nano-v2025.01). Merge with scripts/kconfig/merge_config.sh.
# Device tree overlays: the "fdt apply" command and the "fdtoverlays" line of extlinux.conf,
# for the overlay that goes with the FPGA design loaded from the SD card
CONFIG_OF_LIBFDT_OVERLAY=y
# ft_board_setup(), added by qspi-flash.patch: U-Boot enables the QSPI flash controller in
# Linux's device tree and sets its clock rate, when the board's flash contents give the SoC
# the flash
CONFIG_OF_BOARD_SETUP=y
# The LED wired to the SoC (hps_led0 in the board's device tree) and the "led" command, with
# blinking
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_LED_BLINK=y
CONFIG_LED_SW_BLINK=y

#!/bin/sh
# Run a command with Quartus Pro on the PATH, in the current directory.
#
# Usage: fpga/q COMMAND [ARGS...]
#   fpga/q quartus_sh --version
#   fpga/q jtagconfig -n
#
# The version wanted is in fpga/QUARTUS_VERSION. A core image loads only on an HPS image made
# with the same Quartus version, so the version is part of the design, not a preference.
#
# Quartus is looked for on this machine: in the directory named by DE25_QUARTUS, then where
# Altera's installer puts it, ~/altera/<version> and /opt/altera/<version>, then on the PATH.
# The directory is the one that holds quartus/, qsys/ and niosv/. The installation needs the
# Agilex 5 device support and RiscFree, for the firmware of the design's self-test processor.
#
# If none is found, a container is tried: Altera's image for that version from Docker Hub,
# with the tools of fpga/quartus/Dockerfile added. Altera has published images up to 26.1.1
# and none for 26.3, so for 26.3 this fails and says so. In the container the whole
# repository is visible at the same path, and so are the current directory and the
# directories named in DE25_Q_MOUNTS (separated by spaces).
#
# Quartus fetches its licence by itself the first time the fitter runs: this FPGA family is
# free but licensed.
# shellcheck disable=SC2086
set -eu
top=$(cd "$(dirname "$0")/.." && pwd)
version=$(cat "$top/fpga/QUARTUS_VERSION")
fail() { echo "fpga/q: $*" >&2; exit 1; }
[ $# -gt 0 ] || { sed -n '2,22p' "$0"; exit 2; }
[ "$1" != --usb ] || shift      # once needed for JTAG from the container; accepted and ignored

is_version() {   # is_version DIR: DIR holds Quartus of the version wanted
    [ -x "$1/quartus/bin/quartus_sh" ] &&
        "$1/quartus/bin/quartus_sh" --version 2>/dev/null | grep -q "^Version $version[. ]"
}
root=
for d in "${DE25_QUARTUS:-}" "$HOME/altera/$version" "/opt/altera/$version" "$HOME/altera_pro/$version" \
         "$(dirname "$(dirname "$(dirname "$(command -v quartus_sh 2>/dev/null || echo /x/x/x/x)")")")"; do
    [ -n "$d" ] || continue
    if is_version "$d"; then root=$d; break; fi
done
if [ -n "$root" ]; then
    QUARTUS_ROOTDIR=$root/quartus
    PATH=$root/quartus/bin:$root/qsys/bin:$root/niosv/bin:$PATH
    export QUARTUS_ROOTDIR PATH
    exec "$@"
fi
[ -z "${DE25_QUARTUS:-}" ] || fail "DE25_QUARTUS=$DE25_QUARTUS does not hold Quartus Pro $version"

# No installation: a container, if Altera has an image for this version.
command -v docker >/dev/null || fail "no Quartus Pro $version on this machine (set DE25_QUARTUS to its directory), and no Docker"
docker build -q -t "de25-nano-quartus:$version" --build-arg "VERSION=$version" "$top/fpga/quartus" >/dev/null 2>&1 ||
    fail "no Quartus Pro $version on this machine, and no container image for it could be built.
Install Quartus Pro $version with Agilex 5 device support and RiscFree (fpga/README.md,
\"Tools to download\"), in ~/altera/$version or with DE25_QUARTUS set to its directory."
qhome=$top/work/quartus-home
mkdir -p "$qhome"
extra=
case $PWD/ in
    "$top"/*) ;;
    *) d=$(git rev-parse --show-toplevel 2>/dev/null || pwd); extra="-v $d:$d" ;;
esac
for d in ${DE25_Q_MOUNTS:-}; do
    case $d/ in
        "$top"/*) ;;
        *) extra="$extra -v $d:$d" ;;
    esac
done
# --net=host: the licence is tied to a network card's address.
exec docker run --rm --net=host --user "$(id -u):$(id -g)" \
    -e HOME=/qhome -v "$qhome":/qhome -v "$top":"$top" $extra -w "$PWD" "de25-nano-quartus:$version" "$@"

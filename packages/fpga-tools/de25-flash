#!/bin/sh
# de25-flash: write the board's flash, which holds the HPS image, and keep U-Boot on the card
# in step with it.
#
#   de25-flash status                   say what the flash and the card hold
#   de25-flash write [--force] [NAME]   write the HPS image of the boot package
#                                       de25-nano-boot-NAME to the flash, and put its
#                                       u-boot.itb and boot.scr on the card
#   de25-flash restore [--force] [FILE] write saved flash contents back (default: the saved
#                                       file on the card, if there is exactly one)
#   de25-flash sync                     renew u-boot.itb and boot.scr on the card, if the
#                                       flash already holds the installed HPS image
#
# write and restore ask before they change the flash; --force does it without asking.
# Nothing else writes the flash. See de25-flash(8).
#
# A boot package, in /usr/lib/de25-nano/boot/NAME, is what runs before the kernel: hps.rpd,
# the HPS image (the SoC's settings and U-Boot's SPL), which goes in the flash; u-boot.itb,
# which the SPL loads from the FAT partition (/boot/firmware); and boot.scr, the script
# U-Boot runs there. The three are one build and are put in place together.
#
# A board with the factory flash contents keeps the flash from the SoC: Linux has no
# /dev/mtd0, and the chip's Secure Device Manager (SDM) must do the writing. On such a board
# "write" leaves hps.rpd on the FAT partition as write-on-boot.rpd, with its crc32 in
# write-on-boot.txt, and at the next boot U-Boot's script checks it, saves what the flash held
# as saved-<crc32>.rpd on the FAT partition, and writes it through the SDM. The LED beside the
# HPS KEY button shows how the write is going. Where Linux has the flash, "write" writes it
# directly.
set -eu
. "${DE25_COMMON:-/usr/lib/de25-nano/common.sh}"
usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

boot_dir() { echo "$lib/boot/$1"; }
need_boot() {
    for f in hps.rpd u-boot.itb boot.scr; do
        [ -f "$(boot_dir "$1")/$f" ] ||
            fail "no boot package $1 (no $f in $(boot_dir "$1")). Installed: $(boot_names | tr '\n' ' ')"
    done
}
only_boot() {   # the installed boot package, when there is exactly one
    set -- $(boot_names)
    [ $# -ne 0 ] || fail "no boot package is installed (de25-nano-boot-...)"
    [ $# -eq 1 ] || fail "$# boot packages are installed ($*): name one"
    echo "$1"
}
card_matches() { # card_matches NAME: the card has that package's u-boot.itb and boot.scr
    cmp -s "$(boot_dir "$1")/u-boot.itb" "$fat/u-boot.itb" && cmp -s "$(boot_dir "$1")/boot.scr" "$fat/boot.scr"
}
card_put() {    # card_put NAME: put them there, keeping the U-Boot that was there
    if [ -f "$fat/u-boot.itb" ] && ! cmp -s "$(boot_dir "$1")/u-boot.itb" "$fat/u-boot.itb"; then
        cp "$fat/u-boot.itb" "$fat/u-boot-previous.itb"
    fi
    put "$(boot_dir "$1")/boot.scr" "$fat/boot.scr"
    put "$(boot_dir "$1")/u-boot.itb" "$fat/u-boot.itb"
    sync
}
remove_request() { rm -f "$request" "$request.new" "$request_txt" "$failed"; }
flash_write() {  # flash_write FILE: write and verify, from Linux
    if [ -n "$root" ]; then
        dd if="$1" of="$mtd" conv=notrunc status=none
    else
        /usr/sbin/flashcp -v "$1" "$mtd"
    fi
}
need_whole_flash() {
    [ -n "$root" ] || [ "$(cat /sys/class/mtd/mtd0/size)" = $flash_bytes ] ||
        fail "$mtd is not the whole $flash_bytes-byte flash"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
arg1=
for arg in "$@"; do
    case $arg in
    --force) force=yes ;;
    -*) usage ;;
    *) [ -z "$arg1" ] || usage; arg1=$arg ;;
    esac
done

case $cmd in
write)
    need_root write
    name=${arg1:-$(only_boot)}
    need_boot "$name"
    need_fat
    rpd=$(boot_dir "$name")/hps.rpd
    size=$(stat -c %s "$rpd")
    [ "$size" -gt 0 ] && [ "$size" -le $flash_bytes ] && [ $((size % 4)) -eq 0 ] ||
        fail "$rpd has an unusable size ($size bytes)"
    if ! flash_handed_over; then
        # The SDM keeps the flash: U-Boot writes it, at the next boot.
        cat <<EOF
This board's flash holds the factory contents, or others that keep it from the SoC.
At the next boot U-Boot will save what the flash holds now to the card
($fat/saved-<crc32>.rpd), then write the HPS image of de25-nano-boot-$name to the
flash, which should take about two minutes.
EOF
        confirm "Write the flash at the next boot?"
        remove_request
        card_put "$name"
        # Last, so that U-Boot finds the request only when everything else is in place.
        cp "$rpd" "$request.new"
        cmp -s "$rpd" "$request.new" || fail "copying hps.rpd to $fat failed"
        printf 'flash_new_crc=%s\nflash_new_boot=%s\n' "$(crc32_of "$rpd")" "$name" > "$request_txt"
        sync
        mv "$request.new" "$request"
        sync
        cat <<EOF
The flash will be written at the next boot. Reboot when ready (sudo reboot), then watch
the LED beside the HPS KEY button:
  one second on, one second off   working: leave the power alone
  steady on                       done: unplug the power, then plug it in again
  four times a second             it failed: the serial console says why
To have a core loaded after that, select it before you reboot: sudo de25-fpga select base
EOF
    elif flash_holds "$rpd"; then
        remove_request
        if card_matches "$name"; then
            echo "The flash already holds the HPS image of de25-nano-boot-$name, and the card its U-Boot: nothing to do."
        else
            card_put "$name"
            echo "The flash already holds the HPS image of de25-nano-boot-$name: it is not written."
            echo "u-boot.itb and boot.scr on the card have been renewed; they take effect at the next boot."
        fi
    else
        [ -r "$mtd" ] || fail "cannot read $mtd"
        need_whole_flash
        cat <<EOF
This writes the HPS image of de25-nano-boot-$name to the board's flash, from Linux.
What the flash holds now is not the factory contents and is not saved.
EOF
        confirm "Write the flash now?"
        remove_request
        flash_write "$rpd"
        card_put "$name"
        cat <<EOF
The flash is written and verified, and u-boot.itb and boot.scr on the card are renewed.
The chip takes up the new contents only at power-on: shut down (sudo systemctl halt),
then unplug the board's power and plug it in again. Do not restart without the power cycle.
EOF
        sel=$(selected_core)
        if [ -n "$sel" ] && [ "$sel" != unknown ] && [ -f "$lib/core/$sel/boot" ] &&
           [ "$(cat "$lib/core/$sel/boot")" != "$name" ]; then
            echo "The selected core, $sel, does not load on this HPS image: select another, or sudo de25-fpga disable."
        elif [ "$sel" = unknown ]; then
            echo "The core on the card was put there without de25-fpga select: check that it loads on this HPS image, or sudo de25-fpga disable."
        fi
    fi
    ;;
restore)
    need_root restore
    need_fat
    file=$arg1
    flash_handed_over || fail "Linux has no access to this board's flash (no $mtd).
That is so with the factory flash contents: there is nothing to restore."
    if [ -z "$file" ]; then
        # The saved file on the card, if there is exactly one.
        n=0
        for f in "$fat"/saved-????????.rpd; do
            [ -f "$f" ] || continue
            n=$((n + 1)); file=$f
        done
        [ "$n" -ne 0 ] || fail "no saved flash contents ($fat/saved-<crc32>.rpd).
You must specify a file name: de25-flash restore FILE"
        [ "$n" -eq 1 ] || fail "there are $n saved files in $fat.
You must specify a file name: de25-flash restore FILE"
    fi
    [ -f "$file" ] || fail "no $file"
    size=$(stat -c %s "$file")
    [ "$size" -eq $flash_bytes ] || fail "$file is $size bytes; saved flash contents are $flash_bytes"
    need_whole_flash
    crc=$(crc32_of "$file")
    case ${file##*/} in
    saved-????????.rpd)
        [ "${file##*/}" = "saved-$crc.rpd" ] || fail "$file does not hold what its name says: its crc32 is $crc"
        ;;
    esac
    echo "$file: crc32 $crc"
    echo "This writes $file to the board's flash and stops a core being loaded at boot."
    confirm "Write the flash now?"
    rm -f "$fat/fpga.rbf" "$dtbo/fpga.dtbo" "$selected_txt"
    remove_request
    menu_update
    sync
    flash_write "$file"
    cat <<EOF
The flash is written and verified. The chip takes up the new contents only at power-on:
shut down (sudo systemctl halt), then unplug the board's power and plug it in again.
Do not restart without the power cycle.
EOF
    ;;
sync)
    # Also run when a boot package is installed or upgraded. Nothing happens where the card
    # is not mounted (an image being built), and the flash is never written.
    [ -z "$arg1" ] || usage
    need_root sync
    fat_mounted || exit 0
    [ -n "$(boot_names)" ] || exit 0
    if ! flash_handed_over; then
        echo "de25-flash: the flash holds the factory contents: u-boot.itb and boot.scr on the card are left as they are (sudo de25-flash write puts the installed boot package into effect)."
        exit 0
    fi
    name=$(flash_boot)
    if [ -z "$name" ]; then
        cat <<EOF
de25-flash: the flash does not hold the HPS image of an installed boot package, so
u-boot.itb and boot.scr on the card are left as they are. To bring the board to the
installed boot package, which writes the flash:
    sudo de25-flash write
EOF
    elif card_matches "$name"; then
        echo "de25-flash: the flash and the card hold de25-nano-boot-$name as installed."
    else
        card_put "$name"
        echo "de25-flash: the flash holds the HPS image of de25-nano-boot-$name as installed; u-boot.itb and boot.scr on the card have been renewed and take effect at the next boot."
    fi
    ;;
status)
    [ -z "$arg1" ] || usage
    if ! flash_handed_over; then
        echo "Flash: kept from the SoC, as with the factory contents; de25-flash write has U-Boot write it"
    elif [ ! -r "$mtd" ]; then
        echo "Flash: handed to the SoC ($mtd); run status as root to see what it holds"
    else
        name=$(flash_boot)
        if [ -n "$name" ]; then
            v=$(version_of "de25-nano-boot-$name")
            echo "Flash: holds the HPS image of de25-nano-boot-$name${v:+ $v}, as installed"
        elif [ -n "$(running_boot)" ]; then
            echo "Flash: holds an HPS image of de25-nano-boot-$(running_boot) (the running core loaded on it), not the build now installed"
        else
            echo "Flash: handed to the SoC ($mtd); it does not hold the HPS image of an installed boot package"
        fi
    fi
    if fat_mounted; then
        found=
        for b in $(boot_names); do
            if card_matches "$b"; then found=$b; fi
        done
        if [ -n "$found" ]; then
            echo "Card: u-boot.itb and boot.scr are those of de25-nano-boot-$found, as installed"
        else
            echo "Card: u-boot.itb and boot.scr are not those of an installed boot package"
        fi
    else
        echo "Card: $fat is not mounted"
    fi
    if [ -f "$request" ] && flash_handed_over; then
        echo "Flash write: $request is on the card, but U-Boot writes the flash only when it is kept from the SoC; de25-flash write removes the file"
    elif [ -f "$request" ]; then
        b=$(pending_boot)
        echo "Flash write: waiting for the next boot${b:+ (de25-nano-boot-$b)}"
    elif [ -f "$failed" ]; then
        echo "Flash write: the last one failed while $(tr -d '\000' < "$failed" | sed -n 's/^failed_while=//p')"
    else
        echo "Flash write: none waiting"
    fi
    for f in "$fat"/saved-????????.rpd; do
        [ -f "$f" ] || continue
        echo "Saved flash contents: $f"
    done
    ;;
*)
    usage
    ;;
esac

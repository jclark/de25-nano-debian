#!/bin/sh
# de25-fpga: choose the core image that U-Boot loads into the FPGA at boot.
#
#   de25-fpga list                    the installed cores; which is selected, which is running
#   de25-fpga select [--force] NAME   load that core from the next boot on
#   de25-fpga disable                 load no core from the next boot on
#   de25-fpga status                  say how things stand
#
# It never writes the flash: that is de25-flash. See de25-fpga(8).
#
# A core is installed by a package, de25-nano-core-NAME, in /usr/lib/de25-nano/core/NAME: the
# core image fpga.rbf, its device tree overlay fpga.dtbo, and a file boot naming the boot
# package (de25-nano-boot-...) whose HPS image it loads on. Selecting a core copies fpga.rbf to
# the FAT partition (/boot/firmware), where U-Boot's script loads it, and fpga.dtbo to
# /boot/dtbo, where the boot menu names it; U-Boot applies the overlay only when the core image
# has loaded. The name of the selected core is kept beside fpga.rbf, in fpga-core.txt.
#
# A core image loads only on the HPS image it was built for. A refused core leaves the board
# unable to restart until its power is cycled, so "select" wants to see that the core fits
# (fits, in common.sh) and otherwise needs --force.
set -eu
. "${DE25_COMMON:-/usr/lib/de25-nano/common.sh}"
usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

core_dir() { echo "$lib/core/$1"; }
core_boot() { cat "$(core_dir "$1")/boot"; }
need_core() {
    [ -f "$(core_dir "$1")/fpga.rbf" ] && [ -f "$(core_dir "$1")/fpga.dtbo" ] && [ -f "$(core_dir "$1")/boot" ] ||
        fail "no core $1 (no fpga.rbf, fpga.dtbo and boot in $(core_dir "$1")). Installed: $(core_names | tr '\n' ' ')"
}
boot_id() { cat "$root/proc/sys/kernel/random/boot_id" 2>/dev/null || echo unknown; }

put_core() {    # put_core NAME: put the core where the boot uses it
    mkdir -p "$dtbo"
    put "$(core_dir "$1")/fpga.dtbo" "$dtbo/fpga.dtbo"
    put "$(core_dir "$1")/fpga.rbf" "$fat/fpga.rbf"
    printf 'core=%s\nboot=%s\nboot_id=%s\n' "$1" "$(core_boot "$1")" "$(boot_id)" > "$selected_txt"
    menu_update
    sync
}
remove_core() {
    rm -f "$fat/fpga.rbf" "$fat/fpga.rbf.new" "$dtbo/fpga.dtbo" "$dtbo/fpga.dtbo.new" "$selected_txt"
    menu_update
    sync
}
does_not_fit() {    # does_not_fit NAME: explain, after fits has failed
    cat >&2 <<EOF
$prog: it cannot be shown that the core $1 will load on this board: $why.
It needs the HPS image of de25-nano-boot-$(core_boot "$1") in the flash. To write it:
    sudo de25-flash write
A core that the chip refuses leaves the board unable to restart until its power is cycled.
EOF
}

cmd=${1:-}
[ $# -gt 0 ] && shift
name=
hook=
if [ "$cmd" = hook ]; then
    [ $# -eq 2 ] || usage
    hook=$1; name=$2
    set --
fi
for arg in "$@"; do
    case $arg in
    --force) force=yes ;;
    -*) usage ;;
    *) [ -z "$name" ] || usage; name=$arg ;;
    esac
done

case $cmd in
list)
    [ -z "$name" ] || usage
    sel=$(selected_core); run=$(running_core)
    [ -n "$(core_names)" ] || echo "No cores are installed (packages de25-nano-core-...)."
    for c in $(core_names); do
        state=
        [ "$c" != "$sel" ] || state="selected"
        [ "$c" != "$run" ] || state="${state:+$state, }running"
        printf '%-12s %-20s for de25-nano-boot-%s\n' "$c" "$state" "$(core_boot "$c")"
    done
    ;;
select)
    [ -n "$name" ] || usage
    need_root "select $name"
    need_core "$name"
    need_fat
    if fits "$(core_boot "$name")"; then
        echo "The core $name fits: $why."
    elif [ "$force" = yes ]; then
        echo "The core $name is selected without a check that it fits ($why)."
    else
        does_not_fit "$name"
        echo "To select it all the same: sudo de25-fpga select --force $name" >&2
        exit 1
    fi
    put_core "$name"
    echo "The core $name will be loaded from the next boot on."
    ;;
disable)
    [ -z "$name" ] || usage
    need_root disable
    need_fat
    remove_core
    echo "No core will be loaded from the next boot on."
    ;;
status)
    [ -z "$name" ] || usage
    sel=$(selected_core); run=$(running_core)
    if [ -n "$sel" ] && [ ! -f "$dtbo/fpga.dtbo" ]; then
        echo "Selected core: $sel, but its overlay is missing from $dtbo: run de25-fpga select or de25-fpga disable"
    elif [ -z "$sel" ] && [ -f "$dtbo/fpga.dtbo" ]; then
        echo "Selected core: none, but an overlay is left in $dtbo: run de25-fpga select or de25-fpga disable"
    elif [ -z "$sel" ]; then
        echo "Selected core: none"
    elif [ "$sel" = unknown ]; then
        echo "Selected core: one put on the card without de25-fpga select (no $selected_txt)"
    else
        v=$(version_of "de25-nano-core-$sel")
        echo "Selected core: $sel${v:+ (de25-nano-core-$sel $v)}"
    fi
    if [ -n "$run" ]; then
        echo "Running core: $run, on the HPS image of de25-nano-boot-$(running_boot)"
    elif unnamed_core_running; then
        echo "Running core: one without a name (release 0.1's, or one put on the card by hand)"
    else
        echo "Running core: none"
    fi
    if [ -n "$sel" ] && [ "$sel" != unknown ] && [ "$sel" != "$run" ]; then
        if [ "$(sed -n 's/^boot_id=//p' "$selected_txt" 2>/dev/null)" = "$(boot_id)" ]; then
            echo "The core $sel will be loaded at the next boot."
        elif ! flash_handed_over; then
            echo "The core $sel was not loaded: the flash is not written yet. See de25-flash status."
        else
            cat <<EOF
The core $sel was selected but is not running: the chip refused it, or U-Boot could not
read it. If it was refused, the board will not restart until its power is cycled: unplug
the power and plug it in again rather than rebooting. See de25-flash status.
EOF
        fi
    fi
    ;;
hook)
    # For the maintainer scripts of core packages: de25-fpga hook configure|remove NAME.
    # Nothing here may fail a package installation, and nothing happens where the card is
    # not mounted (an image being built).
    fat_mounted || exit 0
    [ "$(selected_core)" = "$name" ] || exit 0
    case $hook in
    configure)
        [ -f "$(core_dir "$name")/fpga.rbf" ] || exit 0
        if cmp -s "$(core_dir "$name")/fpga.rbf" "$fat/fpga.rbf" &&
           cmp -s "$(core_dir "$name")/fpga.dtbo" "$dtbo/fpga.dtbo"; then
            exit 0
        fi
        if fits "$(core_boot "$name")"; then
            put_core "$name"
            echo "de25-fpga: the selected core, $name, has been updated; the new one loads at the next boot."
        else
            cat <<EOF
de25-fpga: the selected core, $name, has a new version that needs the HPS image of
de25-nano-boot-$(core_boot "$name") in the flash, and it cannot be shown to fit: $why.
The card keeps the version it has. To change over:
    sudo de25-flash write      (then power cycle as it says)
    sudo de25-fpga select $name
EOF
        fi
        ;;
    remove)
        remove_core
        echo "de25-fpga: the selected core, $name, is being removed: no core will be loaded from the next boot on."
        ;;
    esac
    ;;
*)
    usage
    ;;
esac
